{
  "name": "sheet-lite",
  "version": "0.5.0",
  "description": "Lightweight and secure library to read, write and edit Excel (XLSX) without breaking your file. Zero transitive dependencies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/index.mjs",
  "jsdelivr": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./stream": {
      "types": "./dist/stream.d.mts",
      "import": "./dist/stream.mjs",
      "require": "./dist/stream.cjs"
    },
    "./write": {
      "types": "./dist/write.d.mts",
      "import": "./dist/write.mjs",
      "require": "./dist/write.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsdown && node scripts/bench.mjs",
    "bench:stream": "tsdown && node --expose-gc scripts/bench-stream.mjs",
    "bench:write": "tsdown && node --expose-gc scripts/bench-write.mjs",
    "size": "node scripts/size.mjs",
    "validate:corpus": "tsdown && node scripts/validate-corpus.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "ooxml",
    "read",
    "write",
    "edit",
    "lightweight",
    "zero-dependencies",
    "exceljs-alternative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naaach/sheet-lite.git"
  },
  "homepage": "https://github.com/Naaach/sheet-lite#readme",
  "bugs": {
    "url": "https://github.com/Naaach/sheet-lite/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "exceljs": "^4.4.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "xlsx": "^0.18.5"
  }
}
